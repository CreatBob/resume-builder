# author: Bob

# 根目录 .env 供前端 Vite 本地开发读取。
# 后端配置请分别复制：
# - spring-ai-backend/.env.example
# - python-ai-backend/.env.example

# 功能展示模式：
# - resume-only：仅保留简历工作台与简历 AI 优化（默认）
# - full：仅作全栈配置保留；前端主界面统一聚焦简历工作台
VITE_APP_FEATURE_MODE=resume-only

# 简历存储模式：
# - local：只用浏览器本地存储
# - remote：只用后端 /api/resumes
# - auto：优先探测后端，失败时回退本地
VITE_RESUME_STORAGE_MODE=auto

# AI 简历优化调用通道（可选）：
# - byok：固定使用前端配置的服务商 URL 与 API Key（默认）
# - auto：默认走前端 BYOK；若仅需强制后端通道可设为 backend
# - backend：固定走后端 /api/ai/chat/stream
VITE_AI_PROVIDER_MODE=byok

# 纯前端 BYOK 边缘跨域代理路径与 Cloudflare KV 分享接口（可选，默认适配 Cloudflare Pages Functions）
VITE_AI_PROXY_PATH=/api/ai-proxy/chat/completions
VITE_CLOUDFLARE_SHARE_API=/api/shares
